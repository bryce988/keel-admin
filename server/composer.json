{
    "name": "keel/admin-server",
    "type": "project",
    "description": "Keel 后端 · webman 多应用",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-zip": "*",
        "ezyang/htmlpurifier": "^4.19",
        "firebase/php-jwt": "^7.0",
        "illuminate/database": "^11.0",
        "illuminate/events": "^11.0",
        "illuminate/pagination": "^11.0",
        "monolog/monolog": "^3.0",
        "openspout/openspout": "^5.10",
        "predis/predis": "^2.2",
        "symfony/mailer": "^7.3",
        "webman/redis-queue": "^2.1",
        "webman/validation": "^2.2",
        "workerman/crontab": "^1.0",
        "workerman/webman-framework": "^2.0",
        "zoujingli/ip2region": "^3.0"
    },
    "suggest": {
        "ext-event": "更高性能的事件循环",
        "ext-redis": "phpredis 扩展，性能优于 predis，生产环境可替换"
    },
    "autoload": {
        "psr-4": {
            "": "./",
            "app\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "@php scripts/lint.php"
        ],
        "check": [
            "@composer validate --no-check-publish",
            "@lint"
        ]
    },
    "scripts-descriptions": {
        "lint": "对 vendor/runtime 之外的所有 PHP 文件跑 php -l 语法检查",
        "check": "composer validate + lint，提交前的后端自检"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
