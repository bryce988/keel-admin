# ============================================================
# Keel 环境变量 —— 复制为 .env 后按需修改
#   cp .env.example .env
# docker compose 会把这些变量注入到各容器中
# ============================================================

# ---------- 应用 ----------
APP_NAME=Keel
APP_ENV=dev                     # dev / test / prod，prod 下不返回异常堆栈
APP_DEBUG=true

# ---------- 端口（宿主机） ----------
PORT_WEB=5173                   # 前端开发服务器
PORT_SERVER=8787                # 后端 HTTP
PORT_MYSQL=3306
PORT_REDIS=6379

# ---------- 数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=keel
DB_USERNAME=keel
DB_PASSWORD=keel123456
DB_ROOT_PASSWORD=root123456

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
# 生产环境务必替换：php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-in-production-0123456789abcdef
JWT_ACCESS_TTL=7200             # access token 有效期（秒），默认 2 小时
JWT_REFRESH_TTL=604800          # refresh token 有效期（秒），默认 7 天

# ---------- 安全策略 ----------
LOGIN_FAIL_LIMIT=5              # 连续失败次数上限
LOGIN_LOCK_MINUTES=30           # 锁定时长（分钟）
CAPTCHA_TTL=120                 # 验证码有效期（秒）

# ---------- 初始管理员 ----------
# 首次启动时创建，之后修改此项不再生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
